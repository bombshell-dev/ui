{
	"name": "root",
	"private": "true",
	"version": "0.0.0",
	"keywords": [
		"bombshell",
		"cli"
	],
	"homepage": "https://bomb.sh/docs/ui",
	"license": "MIT",
	"author": {
		"name": "Bombshell",
		"email": "oss@bomb.sh",
		"url": "https://bomb.sh"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bombshell-dev/ui.git"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepare": "pnpm --filter @bomb.sh/web-platform-tests exec playwright install --with-deps chromium",
		"dev": "bsh dev",
		"build": "pnpm -r --filter '@clack/*...' run build",
		"bench": "vitest bench --project 'bench (bench)' --reporter=verbose",
		"format": "bsh format",
		"format:check": "bsh format --check",
		"lint": "bsh lint .",
		"test": "pnpm -r --filter root run --workspace-concurrency=1 '/^test:(unit:run|wpt)$/' --run",
		"test:unit": "vitest --config vitest.config.mts --project unit",
		"test:unit:run": "vitest run --config vitest.config.mts --project unit",
		"test:wpt": "pnpm --filter @clack/ui test:wpt"
	},
	"devDependencies": {
		"@bomb.sh/tools": "^0.8.0",
		"@changesets/cli": "^3.0.3",
		"@codspeed/vitest-plugin": "^6.1.0",
		"@termless/core": "^0.10.2",
		"@termless/test": "^0.10.2",
		"@types/node": "^22.20.0",
		"node-pty": "1.2.0-beta.15",
		"vitest": "5.0.5"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.28.13",
			"onFail": "warn"
		},
		"runtime": {
			"name": "node",
			"version": "22.23.5",
			"onFail": "warn"
		}
	}
}
