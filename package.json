{
	"name": "@bomb.sh/ui-workspace",
	"version": "0.0.0",
	"keywords": [
		"bombshell",
		"cli"
	],
	"homepage": "https://bomb.sh/docs/ui",
	"license": "MIT",
	"author": {
		"name": "Bombshell",
		"email": "oss@bomb.sh",
		"url": "https://bomb.sh"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bombshell-dev/ui.git"
	},
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"dev": "bsh dev",
		"build": "pnpm --filter \"@clack/*\" run build",
		"bench": "pnpm -r --workspace-concurrency=1 --if-present bench",
		"format": "bsh format",
		"format:check": "bsh format --check",
		"lint": "bsh lint .",
		"test": "bsh test"
	},
	"devDependencies": {
		"@bomb.sh/tools": "^0.8.0",
		"@termless/core": "^0.10.2",
		"@termless/test": "^0.10.2",
		"@types/node": "^22.20.0",
		"node-pty": "1.2.0-beta.15",
		"vitest": "5.0.5"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "10.7.0",
			"onFail": "warn"
		},
		"runtime": {
			"name": "node",
			"version": "22.23.4",
			"onFail": "error"
		}
	}
}
