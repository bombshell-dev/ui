{
	"name": "@bomb.sh/web-platform-tests",
	"version": "0.0.0",
	"private": true,
	"description": "Run upstream Web Platform Tests against a DOM implementation",
	"type": "module",
	"license": "MIT",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json",
		"./config": {
			"types": "./dist/config.d.mts",
			"import": "./dist/config.mjs"
		},
		"./vitest": {
			"types": "./dist/vitest.d.mts",
			"import": "./dist/vitest.mjs"
		},
		"./vitest/runner": {
			"types": "./dist/vitest/runner.d.mts",
			"import": "./dist/vitest/runner.mjs"
		}
	},
	"scripts": {
		"build": "bsh build src/index.ts src/config.ts src/cli.ts src/vitest.ts src/vitest/runner.ts --dts",
		"typecheck": "tsc -p tsconfig.json",
		"format": "bsh format",
		"lint": "bsh lint"
	},
	"devDependencies": {
		"typescript": "^6.0.2"
	},
	"bin": {
		"wpt": "./bin/wpt.mjs"
	},
	"dependencies": {
		"@bomb.sh/router": "^0.8.0",
		"parse5": "^8.1.1",
		"vite": "^8.1.0",
		"vitest": "5.0.5",
		"zod": "^4.4.3"
	},
	"files": [
		"dist",
		"bin",
		"WPT_REVISION"
	]
}
