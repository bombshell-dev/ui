{
	"name": "@bomb.sh/web-platform-tests",
	"version": "0.0.0",
	"private": true,
	"description": "Reusable DOM compatibility assertions and development browser validation",
	"type": "module",
	"license": "MIT",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"generate": "node scripts/generate-registry.mjs",
		"build": "pnpm generate && bsh build src/index.ts --dts",
		"test": "bsh test",
		"typecheck": "tsc -p tsconfig.json && tsc -p test/browser/tsconfig.json",
		"test:browser:build": "pnpm generate && vite build --config test/browser/vite.config.mjs",
		"test:browser:run": "node test/browser/run-compatibility.mjs",
		"test:wpt-selectors": "node scripts/check-wpt-selectors.mjs",
		"test:browser:input": "node test/browser/run-compatibility.mjs --input-only",
		"test:browser": "vite --config test/browser/vite.config.mjs --host 127.0.0.1",
		"format": "bsh format",
		"lint": "bsh lint"
	},
	"devDependencies": {
		"@vitest/expect": "5.0.5",
		"chai": "^6.2.2",
		"playwright": "^1.64.1",
		"typescript": "^6.0.2",
		"vite": "^8.1.0"
	}
}
