{
	"name": "@clack/ui",
	"version": "0.0.0",
	"keywords": [
		"bombshell",
		"cli"
	],
	"homepage": "https://bomb.sh/docs/ui",
	"license": "MIT",
	"author": {
		"name": "Bombshell",
		"email": "oss@bomb.sh",
		"url": "https://bomb.sh"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bombshell-dev/ui.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"dev": "bsh dev",
		"build": "bsh build --dts",
		"format": "bsh format",
		"lint": "bsh lint",
		"test:wpt": "pnpm -r --filter '{.}...' run .wpt",
		".wpt": "wpt --config ./wpt.config.ts"
	},
	"dependencies": {
		"@bomb.sh/tty": "catalog:",
		"css-select": "^7.0.0"
	},
	"devDependencies": {
		"@bomb.sh/web-platform-tests": "workspace:*"
	}
}
